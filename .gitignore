node_modules/
dist/
.wrangler/
*.log

# Secrets. .env.example is the committed template and is deliberately
# re-included below; everything else matching these patterns stays local.
# Production secrets should live in Worker secrets (`wrangler secret put`,
# or the Cloudflare dashboard) rather than in any file here — see ADMIN.md.
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example

# Third-party models fetched at build time by scripts/fetch-assets.mjs
# (see THIRD_PARTY_ASSETS.md); not committed.
public/avatars/vroid/

# Seisugbo's original photos, kept local: scripts/optimize-media.mjs
# turns them into the small WebP files the world serves (committed).
worlds/seisugbo/media-src/
