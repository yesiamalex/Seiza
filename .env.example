# Copy to .env.local for dev, and set the same values as Worker vars at
# deploy time. This file IS the "one world per deployment" customization
# surface — fork, change these, redeploy, no code changes needed.

# Which world config under public/worlds/<id>/world.json to load
VITE_SEIZA_WORLD_ID=default

# Optional realtime room server host. Leave this unset for the normal setup:
# production uses the current browser host (including a custom domain), and
# Vite proxies local development to wrangler dev on 127.0.0.1:8787. Set this
# only when the room Worker is intentionally deployed somewhere else.
# VITE_SEIZA_ROOM_HOST=

# Voice chat is a peer-to-peer WebRTC mesh, signaled through the room
# server above — no separate media infrastructure. On unless set to
# "false"; the per-world switch is `voiceEnabled` in world.json. Read the
# scaling note in README.md before a large room: mesh cost is O(n^2) in
# connected peers.
VITE_SEIZA_VOICE_ENABLED=true

# --- TURN (voice/video across different networks) --------------------------
#
# PREFERRED SETUP: do not use the variables in this file at all. Create a
# TURN key at dash.cloudflare.com -> Realtime -> TURN and store it as two
# WORKER SECRETS, so the API token never reaches the browser:
#
#   wrangler secret put CLOUDFLARE_TURN_KEY_ID
#   wrangler secret put CLOUDFLARE_TURN_KEY_API_TOKEN
#
# (or set both under Workers -> your worker -> Settings -> Variables and
# Secrets, as "Secret" type — see ADMIN.md.) The Worker then mints
# short-lived credentials at /api/turn-credentials and the client picks
# them up automatically. Leaving it unset is fine: everything falls back
# to STUN-only. See README.md, "Voice/video across different networks",
# for what relaying costs and the guardrails around it.
#
# NEVER put CLOUDFLARE_TURN_KEY_API_TOKEN in this file or any VITE_ variable.
# Vite inlines VITE_* into the client bundle, which would publish it.
#
# LEGACY: a static TURN server baked in at build time. Kept working for
# deployments already using it, but the credential below ships to every
# browser in the bundle, and it is not covered by the relay throttling or
# the mint rate limit that the Worker endpoint applies.
# VITE_SEIZA_TURN_URLS=turn:turn.example.com:3478
# VITE_SEIZA_TURN_USERNAME=
# VITE_SEIZA_TURN_CREDENTIAL=
