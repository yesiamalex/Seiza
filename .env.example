# Copy to .env.local for dev, and set the same values as Worker vars / PartyKit
# env vars at deploy time. This file IS the "one world per deployment"
# customization surface — fork, change these, redeploy, no code changes needed.

# Which world config under public/worlds/<id>/world.json to load
VITE_SEIZA_WORLD_ID=default

# Realtime room server host (partykit dev default shown; set to your deployed
# PartyKit/Cloudflare host in production)
VITE_SEIZA_PARTY_HOST=127.0.0.1:1999

# Voice chat is a peer-to-peer WebRTC mesh, signaled through the room
# server above — no separate media infrastructure. Off by default; a
# deployer turns it on once they've read the scaling note in README.md
# (mesh cost is O(n^2) in connected peers).
VITE_SEIZA_VOICE_ENABLED=false

# Optional TURN server for voice, on top of the default public STUN
# (stun:stun.cloudflare.com:3478). Only needed if participants are behind
# NATs that STUN alone can't traverse — most same-network/classroom use
# doesn't need this. Comma-separate multiple TURN URLs.
# VITE_SEIZA_TURN_URLS=turn:turn.example.com:3478
# VITE_SEIZA_TURN_USERNAME=
# VITE_SEIZA_TURN_CREDENTIAL=
