{
  // Cloudflare Workers config for the frontend + avatar-upload API.
  // This is what a "Deploy to Cloudflare" button targets.
  //
  // DEPLOY IS STILL TWO PIECES, deliberately: this Worker (static SPA +
  // POST/GET /api/avatars, backed by the KV namespace below) deploys via
  // this file, but the realtime room server (party/room.ts) deploys
  // separately via `npx partykit deploy` (its own control plane on top
  // of Durable Objects). Porting party/room.ts into a Durable Object
  // bound directly here would get to a true single-button deploy, but
  // hinges on the exact shape of the DO WebSocket Hibernation API, which
  // this project hasn't verified against current Cloudflare docs — see
  // party/room.ts's own header comment. Don't attempt that unification
  // without checking current docs first; two verified pieces beats one
  // unverified guess.
  "name": "seiza",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    // Stores user-uploaded .vrm avatars (see worker/index.ts and
    // src/ui/JoinScreen.tsx). KV over R2 specifically because R2
    // requires a payment method on file to activate at all, even for
    // free-tier usage — not what a "fork and deploy for free" project
    // should require. Unlike an R2 bucket_name, a KV namespace is
    // referenced by an opaque id that has to exist before `wrangler
    // deploy` can bind to it, so the placeholder below is real: `npm run
    // build` runs scripts/ensure-kv-namespace.mjs, which looks up (or
    // creates, on first run) a namespace titled "seiza-avatars" and
    // patches this file's id in place before the deploy step runs.
    // That lookup-by-title happens fresh on every build — including a
    // brand new checkout on Cloudflare's Git-connected pipeline, which
    // never sees this rewritten value committed back — so it stays
    // idempotent (reuses the same namespace) without needing to persist
    // anything to git. You can hardcode your own real id here instead
    // once you have one; the script no-ops if it finds one already set.
    { "binding": "AVATARS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "SEIZA_WORLD_ID": "default"
  }
}
